# Anchor - Solo Founder Command Center Environment Configuration

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/anchor_db?sslmode=disable"

# Redis Cache (Sub-100ms API response target)
REDIS_URL="redis://localhost:6379/0"

# Go API Backend Service
PORT=8080
ENV="development"
JWT_SECRET="anchor_super_secret_jwt_key_2026"

# Email Delivery (SMTP — free mail providers supported)
SMTP_PROVIDER="gmail"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="clement@openinfinity.co.za"
SMTP_PASS="your_app_password_here"
FROM_EMAIL="clement@openinfinity.co.za"

# Electron Desktop Tracking Wrapper
DESKTOP_API_URL="http://localhost:8080"
IDLE_THRESHOLD_SECONDS=300
TRACKING_INTERVAL_SECONDS=5

# Client Web Portal Token Secret
PORTAL_SECRET="anchor_portal_signing_secret_9988"
